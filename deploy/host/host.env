# Kasten host settings. install.sh installs this file as /etc/kasten/host.env and keeps the
# values you pass with its options. The kasten-* helpers read it. Nothing here is secret.

# SSH is allowed over tailscale0, and from these addresses or networks on any interface.
# Space-separated IPv4 and IPv6 entries, for example "203.0.113.7 2001:db8:1::/64".
KASTEN_ADMIN_IPS=""

# Size of the encrypted volume file /var/lib/kasten.luks, for example 24G. Used only when
# install.sh creates the volume. "auto" leaves 6 GiB of the root file system free.
KASTEN_DATA_SIZE="auto"

# Seconds one unlock attempt keeps trying Tang. kasten-unlock.service then fails, and systemd
# starts it again a minute later, until Tang answers. Keep it below 840: the unit stops
# kasten-unlock after 15 minutes.
KASTEN_UNLOCK_TIMEOUT=300

# Device-mapper name of the unlocked volume (/dev/mapper/<name>).
KASTEN_DM_NAME=kasten

# The host uid and gid that own the mail server's files in /var/lib/kasten/data. Rootless Podman
# maps the kasten-server image's user (uid 2525) to the kasten user's subordinate IDs: the first
# one plus 2524. install.sh sets it from /etc/subuid; do not change it.
KASTEN_MAIL_UID=

# Existing Kuma event-monitor push URL, in a root-only 0600 file. The personal deployment puts
# it inside LUKS, /var/lib/kasten/secrets/unlock-push-url. Empty disables event pushes. Failed
# unlocks cannot read a file on a locked disk: availability monitoring covers that failure.
KASTEN_UNLOCK_PUSH_URL_FILE=
# Standard Push monitor: down, until reviewed. A verified inverted Push integration may need up.
KASTEN_EVENT_PUSH_STATUS=down
