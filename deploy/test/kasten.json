{
  "//": "Test-only kasten.json for deploy/test/run.sh. It differs from production in two places. The HTTP listener uses dev mode on 127.0.0.1:8080, because production's ACME certificate needs a real certificate authority and public DNS. The relay is the test's SES stand-in, ses-relay: a name outside .test, because Unbound answers every .test name with NXDOMAIN. The secret files it names are generated by run.sh inside the test VPS.",
  "serverHostname": "mx.kasten.test",
  "mailApiHostname": "mail.kasten.test",
  "domains": [{ "name": "kasten.test", "catchAll": null }],
  "users": [
    {
      "email": "you@kasten.test",
      "description": "Deploy test",
      "aliases": [],
      "passwordFile": "you-password"
    },
    {
      "email": "probe@kasten.test",
      "description": "Deploy test probe",
      "aliases": [],
      "passwordFile": "probe-password"
    }
  ],
  "webApp": {
    "origin": "https://app.kasten.test",
    "redirectPath": "/oauth/callback",
    "oauthClientId": "kasten-web"
  },
  "http": { "mode": "dev", "bind": "127.0.0.1:8080" },
  "smtpBind": "[::]:25",
  "imapImportBind": null,
  "relays": [
    {
      "domain": "kasten.test",
      "host": "ses-relay",
      "port": 587,
      "usernameFile": "relay-username",
      "passwordFile": "relay-password"
    }
  ],
  "operatorPublicKeyFile": "operator.pub.asc",
  "admin": {
    "apiUrl": "http://127.0.0.1:8080",
    "apiKeyFile": "admin-api-key",
    "account": "kasten-admin",
    "allowedIps": ["127.0.0.1", "::1"]
  },
  "kumaPushUrlFile": "kuma-url",
  "probe": {
    "account": "probe@kasten.test",
    "passwordFile": "probe-password",
    "kumaPushUrlFile": "kuma-url"
  },
  "dns": { "sesRegion": "eu-central-1" }
}
