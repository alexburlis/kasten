# Test only: run.sh appends these lines to /opt/kasten/.env in the test VPS, and the mail
# containers get every line of that file. A real VPS has no such lines.
# The development network blocks direct DNS (port 53), which Unbound's recursion needs, so
# Unbound forwards every name to Docker's DNS.
KASTEN_DEV_DNS_FORWARD=.
# The test CA of the SES stand-in. run.sh writes it to the data volume after init.
KASTEN_EXTRA_CA_FILE=/var/lib/kasten/relay-ca.crt
