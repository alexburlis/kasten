#!/bin/sh
# Rename the interface that carries a 100.100.75.x address to tailscale0.
set -eu
for path in /sys/class/net/*; do
  ifc=${path##*/}
  [ "$ifc" != tailscale0 ] || exit 0
  if ip -4 -o addr show dev "$ifc" | grep -q ' 100\.100\.75\.'; then
    ip link set "$ifc" down
    ip link set "$ifc" name tailscale0
    ip link set tailscale0 up
    exit 0
  fi
done
