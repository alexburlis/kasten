# Installed as /etc/systemd/system/kasten-tang-firewall.service on the Tang host. It loads only the
# kasten_tang table. Do not enable nftables.service on a Docker host: Debian's default
# /etc/nftables.conf starts with "flush ruleset", which would delete Docker's and Tailscale's rules.
[Unit]
Description=Kasten: only the mail VPS may reach Tang
DefaultDependencies=no
Wants=network-pre.target
Before=network-pre.target shutdown.target tangd.socket
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/kasten/kasten-tang.nft
ExecStop=/usr/sbin/nft delete table inet kasten_tang

[Install]
WantedBy=sysinit.target
