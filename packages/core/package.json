{
  "name": "@kasten/core",
  "version": "0.1.0",
  "private": true,
  "description": "Kasten's shared library: JMAP, OAuth, OpenPGP, MIME, the send flow, the safety checks and local search.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./auth": "./src/auth/index.ts",
    "./crypto": "./src/crypto/index.ts",
    "./jmap": "./src/jmap/index.ts",
    "./mail": "./src/mail/index.ts",
    "./mime": "./src/mime/index.ts",
    "./safety": "./src/safety/index.ts",
    "./search": "./src/search/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test:gpg": "node test/gpg/interop.ts",
    "test:live": "vitest run --config test/live/vitest.config.ts"
  },
  "dependencies": {
    "minisearch": "7.2.0",
    "openpgp": "6.3.2",
    "postal-mime": "4.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/qrcode": "1.5.6",
    "jsqr": "1.4.0",
    "qrcode": "1.5.4"
  },
  "engines": {
    "node": ">=24"
  }
}
