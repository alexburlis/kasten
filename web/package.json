{
  "name": "@kasten/web",
  "version": "0.1.0",
  "private": true,
  "description": "The Kasten web app: a static PWA that decrypts mail on the device.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "preview": "vite preview --port 7480 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "test:image": "vitest run --config image-test/vitest.config.ts"
  },
  "dependencies": {
    "@kasten/core": "workspace:*",
    "dompurify": "3.4.17",
    "entities": "6.0.1",
    "jsqr": "1.4.0",
    "postal-mime": "4.2.0",
    "preact": "10.29.8",
    "qrcode": "1.5.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/qrcode": "1.5.6",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=24"
  }
}
